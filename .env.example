# ==============================================================================
# CHIKITSA-X (National Healthcare Intelligence Cloud) - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (POSTGRESQL - NEON / SUPABASE / RDS / LOCAL)
# ------------------------------------------------------------------------------
# Set this to your PostgreSQL connection string. If omitted, the server runs
# with in-memory resilient state store without crashing.
DATABASE_URL=postgresql://postgres:password@localhost:5432/chikitsax?sslmode=prefer

# ------------------------------------------------------------------------------
# 2. APPLICATION & SERVER PORTS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. ZERO-TRUST SECURITY & ENCRYPTION SECRETS
# ------------------------------------------------------------------------------
# 256-bit Hex Key for AES-256-GCM PHI Health Vault encryption
PHI_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC / JWT Secret Key for token generation & ABHA signature verification
JWT_SECRET=chikitsax_secret_key_prod_change_in_production_2026

# ------------------------------------------------------------------------------
# 4. LIVE NOTIFICATION GATEWAYS (SMS & EMAIL)
# ------------------------------------------------------------------------------
# SMTP Configuration for Real-time OTP & Alert Delivery via Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@chikitsax.gov.in
SMTP_PASS=your-app-specific-password
SMTP_FROM="CHIKITSA-X Healthcare Cloud <alerts@chikitsax.gov.in>"

# SMS Gateway (Fast2SMS / Twilio / Kaleyra / CDAC e-Gov SMS Gateway)
# SMS_GATEWAY_URL=https://api.sms-gateway.in/v1/send
# SMS_API_KEY=your_sms_api_key

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: Set custom API URL if frontend and backend run on different domains
# VITE_API_BASE_URL=https://api.chikitsax.gov.in/api

